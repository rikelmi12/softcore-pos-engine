# Copie para .env.print-agent no computador Windows onde a impressora esta conectada.

# URL do servidor onde o cardapio roda.
# Exemplo em rede local: http://192.168.0.50:8000
PRINT_AGENT_SERVER_URL=http://localhost:8000

# Use exatamente o mesmo token definido no servidor em PRINT_AGENT_TOKEN.
PRINT_AGENT_TOKEN=CHANGE_ME_PRINT_AGENT_TOKEN

# Deixe vazio para usar a impressora padrao do Windows.
# Para descobrir o nome: npm run print-agent:list-printers
PRINT_AGENT_PRINTER=

# Identificacao deste computador na fila de impressao.
PRINT_AGENT_CLIENT_ID=balcao-windows

# Intervalo de busca por comandas novas.
PRINT_AGENT_POLL_MS=2500

# Formato e largura do papel. Use 80 para impressoras termicas de NFe/cupom.
PRINT_AGENT_PRINT_MODE=thermal
PRINT_AGENT_PAPER_WIDTH_MM=80

# Avanco depois da ultima linha, para facilitar rasgar o papel.
PRINT_AGENT_FEED_AFTER_MM=15
