# Core
NODE_ENV=production
PORT=8000
PUBLIC_HOST=127.0.0.1
DATA_DIR=/var/lib/cardapio/data

# Admin
ADMIN_USER=admin
# Usada somente para criar a conta no primeiro inicio. Depois que admin_account
# existir no SQLite, remova esta linha do .env; a senha ativa fica apenas em hash.
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Gere uma vez com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
DATA_ENCRYPTION_KEY=CHANGE_ME_RANDOM_32_CHARACTERS_MINIMUM
# Gere outro valor independente com o mesmo comando. Nao reutilize senhas nem outras chaves.
ORDER_RECEIPT_LINK_SECRET=CHANGE_ME_DIFFERENT_RANDOM_32_CHARACTERS_MINIMUM
ADMIN_SESSION_TTL_MS=28800000

# CORS / Public write protection
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TRUST_PROXY=auto
ALLOW_NULL_ORIGIN=0
PUBLIC_WRITE_REQUIRE_ORIGIN=1

# Database
DB_SYNC_MODE=FULL
DB_BACKUP_KEEP_FILES=2

# Login rate-limit
LOGIN_RATE_WINDOW_MS=600000
LOGIN_RATE_MAX_ATTEMPTS=8
ADMIN_LOGIN_GLOBAL_MAX_ATTEMPTS=8
LOGIN_RATE_BLOCK_MS=900000

# Public order-log rate-limit
ORDER_LOG_WINDOW_MS=60000
ORDER_LOG_MAX_REQUESTS=12
ORDER_LOG_RATE_BLOCK_MS=900000
ORDER_LOG_RATE_BLOCK_AFTER=2
PUBLIC_ORDER_PENDING_TTL_MS=7200000
PUBLIC_ORDER_PENDING_MAX_PER_CLIENT=3
PUBLIC_ORDER_PENDING_MAX_GLOBAL=100

# Public receipt-upload rate-limit
ORDER_RECEIPT_WINDOW_MS=60000
ORDER_RECEIPT_MAX_REQUESTS=10
ORDER_RECEIPT_RATE_BLOCK_MS=900000
ORDER_RECEIPT_RATE_BLOCK_AFTER=2

# Payload / upload limits
MAX_JSON_BODY_BYTES=25165824
MAX_ORDER_LOG_PAYLOAD_BYTES=98304
MAX_ORDER_RECEIPT_BYTES=4194304
ORDER_RECEIPT_PENDING_TTL_MS=3600000
ORDER_RECEIPT_CLEANUP_INTERVAL_MS=900000
ORDER_RECEIPT_MAX_PENDING_PER_IP=3
MAX_PRODUCT_IMAGE_BYTES=2097152
MAX_PRODUCT_IMAGE_URL_CHARS=2000

# Local silent printing (Windows/WSL)
SILENT_PRINT_ENABLED=1
SILENT_PRINT_PRINTER=
SILENT_PRINT_TIMEOUT_MS=20000
SILENT_PRINT_TEXT_MAX_CHARS=30000

# External print-agent
PRINT_AGENT_ENABLED=1
# Opcional: deixe vazio para gerar um token persistente em data/print-agent-token.txt
PRINT_AGENT_TOKEN=
PRINT_AGENT_CLAIM_TTL_MS=120000
PRINT_AGENT_MAX_ATTEMPTS=1

# Optional tunnel (PM2 ecosystem)
CLOUDFLARED_TUNNEL_ID=
